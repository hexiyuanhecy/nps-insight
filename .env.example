# ===========================================
# Vercel KV (Upstash Redis) 配置
# ===========================================
# Vercel KV 已废弃，建议使用 Upstash Redis
# 从 Vercel 项目 Storage 页面创建 Upstash Redis 实例获取

# Redis 连接 URL（格式：redis://xxx.upstash.io:6379）
KV_REST_API_URL=

# Redis 认证 Token
KV_REST_API_TOKEN=

# ===========================================
# 飞书应用配置
# ===========================================
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# ===========================================
# 飞书多维表格配置
# ===========================================
BITABLE_TOKEN=
BITABLE_URL=
BITABLE_FEEDBACK_TABLE_ID=
BITABLE_TAGS_TABLE_ID=
BITABLE_TENANTS_TABLE_ID=
BITABLE_ANALYSIS_TABLE_ID=

# ===========================================
# 数据源 API 配置
# ===========================================
DATA_SOURCE_API_URL=
DATA_SOURCE_API_KEY=
DATA_SOURCE_QUERY_PARAMS={"start":"{{start_unix}}","end":"{{end_unix}}"}

# ===========================================
# 租户信息 API 配置
# ===========================================
TENANT_SOURCE_API_URL=
TENANT_SOURCE_API_KEY=
TENANT_SOURCE_QUERY_PARAMS=

# ===========================================
# AI 配置
# ===========================================
AGNESAI_PROVIDER=agnesai
AGNESAI_API_KEY=
AGNESAI_BASE_URL=https://api.agnes.ai
AGNESAI_MODEL=agnes-2.0-flash

# ===========================================
# 定时任务配置
# ===========================================
# Cron Secret 用于保护定时任务 API
CRON_SECRET=

# 开发模式：设置为 true 启用模拟数据和详细日志
CRON_DEV_MODE=false

# ===========================================
# 通知配置
# ===========================================
# 飞书通知群聊 ID（多个用逗号分隔）
NOTIFICATION_CHAT_ID=

# 管理员用户 ID（多个用逗号分隔）
NOTIFICATION_ADMIN_USER_IDS=

# ===========================================
# 日志平台配置
# ===========================================
# 日志查询平台 URL 模板，使用 {{userId}} 作为占位符
LOG_PLATFORM_URL_TEMPLATE=

# ===========================================
# 默认配置
# ===========================================
# 默认 Owner ID
DEFAULT_OWNER_ID=default_owner

# ===========================================
# 本地开发
# ===========================================
# Next.js 应用 URL
NEXT_PUBLIC_APP_URL=http://localhost:3002
